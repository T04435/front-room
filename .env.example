# Copy to .env.local and fill in. Never commit .env.local.

# Qloo hackathon key (header X-Api-Key): the direct path, and the fallback when NotOnQ errors or is slow
QLOO_API_KEY=
# QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# NotOnQ drop-in API (same paths and shapes as Qloo). With a key set, every Qloo call goes through NotOnQ first.
NOTONQ_API_KEY=
# NOTONQ_BASE_URL=https://notonq.vercel.app/q

# Vercel AI Gateway: an API key locally; on Vercel the project's OIDC token is used
AI_GATEWAY_API_KEY=

# Neon Postgres (Vercel integration). Without it, saved kits go to a local PGlite database in .data/
DATABASE_URL=
