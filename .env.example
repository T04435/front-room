# Copy to .env.local and fill in. Never commit .env.local.

# Qloo hackathon key (header X-Api-Key): the direct path, and the fallback when NotOnQ errors or is slow
QLOO_API_KEY=
# QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# NotOnQ drop-in API (same paths and shapes as Qloo): every call goes there first with QLOO_API_KEY, then Qloo directly.
# Defaults: https://notonq.vercel.app/q/app/front-room on Vercel (previews and production); locally a NotOnQ dev server:
# NOTONQ_BASE_URL=http://localhost:3400/q/app/front-room-dev
# NOTONQ_DISABLED=1

# Vercel AI Gateway: authenticated by the linked Vercel project's OIDC token (no API key). Locally, `vercel env pull`
# writes VERCEL_OIDC_TOKEN into .env.local; it lasts about 12 h, so pull again when model calls start failing.
# (Check what else the pull wrote: a DATABASE_URL would point local dev at the shared database.)
VERCEL_OIDC_TOKEN=

# Neon Postgres (Vercel integration). Without it, saved kits go to a local PGlite database in .data/
DATABASE_URL=
