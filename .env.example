# Copy to .env.local and fill in. Never commit .env.local.

# Qloo hackathon key (header X-Api-Key): the direct path, and the fallback when NotOnQ errors or is slow
QLOO_API_KEY=
# QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# NotOnQ drop-in API (same paths and shapes as Qloo): every call goes there first with QLOO_API_KEY, then Qloo directly.
# Defaults: https://notonq.vercel.app/q/app/music-care on Vercel (previews and production); locally a NotOnQ dev server:
# NOTONQ_BASE_URL=http://localhost:3400/q/app/music-care-dev
# NOTONQ_DISABLED=1

# Vercel AI Gateway: an API key locally; on Vercel the project's OIDC token is used
AI_GATEWAY_API_KEY=

# Neon Postgres (Vercel integration). Without it, saved kits go to a local PGlite database in .data/
DATABASE_URL=
